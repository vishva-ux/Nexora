# Nexora Environment Configuration

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexorapassword
DATABASE_URL=postgresql://postgres:nexorapassword@localhost:5432/nexora

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_SECRET=NexoraSuperSecretKeyForJWTAuthentication2026!MustBeAtLeast32Bytes
JWT_ISSUER=NexoraApi
JWT_AUDIENCE=NexoraClient

# AI Microservice & LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
USE_DEMO_MODE=false

# Application Mode
ENVIRONMENT=development
PORT=3000
